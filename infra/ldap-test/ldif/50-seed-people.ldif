# Fixture entries for the live-LDAP auth tests. The layout and values are
# asserted by services/auth/tests/test_ldap_service_live.py (user1..user6)
# and tests/integration/test_ldap_auth.py (defaults to user10, documents
# user1..user25): ou=people under dc=company,dc=local, uid=userN, mail
# userN@company.local, password Password1. slapd hashes userPassword on
# import; simple binds compare against it.

dn: ou=people,dc=company,dc=local
objectClass: organizationalUnit
ou: people

dn: uid=user1,ou=people,dc=company,dc=local
objectClass: inetOrgPerson
uid: user1
cn: Test User1
sn: User1
mail: user1@company.local
userPassword: Password1

