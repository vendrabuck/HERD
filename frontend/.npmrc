# issue #885: enforce package.json's engines.npm floor. An npm older than
# 11.11.0 silently strips the libc array from optional-platform lockfile
# entries on a plain install, which then drifts package-lock.json against
# what Dependabot's newer npm regenerates. engine-strict turns that mismatch
# into a refusal instead of a silent, invisible rewrite.
engine-strict=true
