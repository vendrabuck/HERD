# HERD Configuration
# These values can also be set via the config page (wrench icon on the login page).
# Environment variables here take precedence over config page values.

# Database
POSTGRES_USER=<db user>
POSTGRES_PASSWORD=<db password>
POSTGRES_DB=<db name>

# Auth Service (required: services will not start without a secret key)
AUTH_SECRET_KEY=<secret key goes here>
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# Authentication backend: "local" (default) or "ldap". When "ldap", the LDAP_*
# settings below must be filled in and /register is disabled.
AUTH_METHOD=local

# LDAP / Active Directory (only consulted when AUTH_METHOD=ldap).
#LDAP_SERVER_URL=ldaps://ad.example.com:636
#LDAP_BIND_DN=CN=herd-svc,OU=ServiceAccounts,DC=example,DC=com
#LDAP_BIND_PASSWORD=<service account password>
#LDAP_USER_BASE_DN=OU=Users,DC=example,DC=com
#LDAP_USER_FILTER=(sAMAccountName={username})
#LDAP_EMAIL_ATTRIBUTE=mail
#LDAP_USERNAME_ATTRIBUTE=sAMAccountName
#LDAP_USE_TLS=true

# Superadmin seed: set all three to create the superadmin account on first startup.
# Once created, these values are ignored on subsequent restarts.
# Leave blank in environments where the superadmin already exists.
SUPERADMIN_EMAIL=<super user email>
SUPERADMIN_USERNAME=<super user>
SUPERADMIN_PASSWORD=<super user password>

# Service URLs (internal Docker network)
INVENTORY_SERVICE_URL=http://inventory:8000
AUTH_SERVICE_URL=http://auth:8000

# CORS (comma-separated origins allowed by all backend services)
CORS_ORIGINS=https://localhost

# Internal service-to-service token (used for inter-service calls: reservations, execution)
INTERNAL_API_TOKEN=<internal api token goes here>

# NATS
NATS_URL=nats://nats:4222

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# AI Orchestrator (optional; blank disables the AI features)
# Provider selector: "anthropic" (Anthropic API) or "openai_compat"
# (any OpenAI-compatible endpoint: vLLM, Ollama, LM Studio, OpenAI, Azure).
AI_PROVIDER=anthropic
# Required when AI_PROVIDER=openai_compat. Example: http://vllm:8000/v1
AI_BASE_URL=
# Canonical API key. Leave blank to disable AI features (anthropic) or to
# use a local server that ignores auth (openai_compat).
AI_API_KEY=
# Model identifier; provider-specific format. claude-* for anthropic;
# e.g. Qwen/Qwen3-35B-Instruct on vLLM, gpt-4o-mini on OpenAI proper.
AI_MODEL=claude-sonnet-4-6
# Deprecated; honored as a fallback for AI_API_KEY for one release.
ANTHROPIC_API_KEY=
