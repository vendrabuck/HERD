# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Node / frontend
node_modules/
dist/
.cache/
*.local

# Environment (keep the example)
.env
.env.*
!.env.example

# TLS material
*.key
infra/traefik/certs/*.srl
infra/traefik/certs/*.csr

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Logs
*.log
logs/

# The unanchored Python lib/ rule above would otherwise swallow the frontend
# source dir; keep it tracked.
!frontend/src/lib/
